// Language books: six volumes per language. Reading volume n raises fluency
// from n-1 to n; volume 6 makes the reader fluent (the plain text).
//
// Book items are tagged and resref'd lang_book_<languageId>_<volume>
// (generated by tools/lang_books.py). The first volume of a language the
// reader does not yet know needs a spare language slot (Intelligence modifier). Later volumes cost no slot.
#include "dmfi_lang_inc"

const string DMFI_LANG_BOOK_PREFIX = "lang_book_";
const int DMFI_LANG_BOOK_VOLUMES = 6;

int LangBookIsBook(string sTag)
{
    return GetStringLeft(sTag, GetStringLength(DMFI_LANG_BOOK_PREFIX)) == DMFI_LANG_BOOK_PREFIX;
}

// Tag lang_book_<id>_<volume>: returns the language id, 0 if malformed.
int LangBookLanguage(string sTag)
{
    string sRest = GetStringRight(sTag, GetStringLength(sTag) - GetStringLength(DMFI_LANG_BOOK_PREFIX));
    int iUnderscore = FindSubString(sRest, "_");
    if (iUnderscore < 1) return 0;
    return StringToInt(GetStringLeft(sRest, iUnderscore));
}

int LangBookVolume(string sTag)
{
    string sRest = GetStringRight(sTag, GetStringLength(sTag) - GetStringLength(DMFI_LANG_BOOK_PREFIX));
    int iUnderscore = FindSubString(sRest, "_");
    if (iUnderscore < 1) return 0;
    return StringToInt(GetStringRight(sRest, GetStringLength(sRest) - iUnderscore - 1));
}

// Item activation: studies the volume. Books are not used up.
void LangBookUse(object oPC, object oBook)
{
    string sTag = GetTag(oBook);
    int iLang = LangBookLanguage(sTag);
    int iVolume = LangBookVolume(sTag);
    if (!LangIsLearnable(iLang) || iVolume < 1 || iVolume > DMFI_LANG_BOOK_VOLUMES)
    {
        SendMessageToPC(oPC, "The text is unreadable.");
        return;
    }

    string sName = LangName(iLang);
    int iLevel = LangFluency(oPC, iLang);
    if (iLevel >= iVolume)
    {
        SendMessageToPC(oPC, "You already know everything volume " + IntToString(iVolume) + " teaches of " + sName + ".");
        return;
    }
    if (iLevel < iVolume - 1)
    {
        if (iLevel == 0)
            SendMessageToPC(oPC, "You cannot follow this. Start with volume 1 of " + sName + ".");
        else
            SendMessageToPC(oPC, "You cannot follow this yet. Study volume " + IntToString(iLevel + 1) + " of " + sName + " first.");
        return;
    }

    // Only a new language (volume 1) takes a slot; later volumes are free.
    if (iLevel == 0)
    {
        if (LangSlotsFree(oPC) < 1)
        {
            SendMessageToPC(oPC, "You have no spare language slots (you know " + IntToString(LangSlotsTotal(oPC)) + " of " + IntToString(LangSlotsTotal(oPC)) + "). Only a higher Intelligence modifier makes room for another language.");
            return;
        }
        SetLocalInt(oPC, DMFI_LANG_VAR_SLOTS_USED, GetLocalInt(oPC, DMFI_LANG_VAR_SLOTS_USED) + 1);
    }
    LangListSet(oPC, iLang, iVolume);
    DeleteLocalInt(oPC, DMFI_LANG_VAR_EXP + IntToString(iLang));
    LangSaveExp(oPC, iLang);

    string sMsg = "You study " + sName + ", volume " + IntToString(iVolume) + " of " + IntToString(DMFI_LANG_BOOK_VOLUMES) + ".";
    if (iVolume >= DMFI_LANG_NATIVE_LEVEL)
        sMsg += " You are now fluent.";
    else
        sMsg += " Volume " + IntToString(iVolume + 1) + " is next.";
    int iFree = LangSlotsFree(oPC);
    sMsg += " You can start " + IntToString(iFree) + " more language" + (iFree == 1 ? "" : "s") + ".";
    SendMessageToPC(oPC, sMsg);
}
