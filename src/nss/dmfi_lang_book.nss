// Language books. Fluency is a number from 0 to 1000; a book adds points to it.
// ---
// Book items are tagged and resref'd lang_book_<languageId>_<volume> (generated by
// tools/lang_books.py). With no settings on the item, the numbers come from the
// volume and the module setting lang_book_volumes (the number of volumes that lead
// from nothing to fluent, 6 by default): volume v of N needs (v-1)/N of fluency
// before it can be followed, and takes the reader to v/N of fluency (volume N, to
// fluent). A builder can set the numbers on any book item with local ints:
//   lang_book_min    fluency needed to follow the book (0 if not set)
//   lang_book_gain   points the book adds (the range from min to max if not set)
//   lang_book_max    the most the book can take a reader to (1000 if not set)
// Setting lang_book_gain or lang_book_max puts the book on its own numbers; the
// volume number then does not matter.
//
// A book is used up when it gives points. A book that is too advanced, or that
// gives nothing because the reader is already at its maximum, is kept. The first
// book of a language the reader does not yet know needs a spare language slot
// (Intelligence modifier). Later books cost no slot.
#include "dmfi_lang_inc"

const string DMFI_LANG_BOOK_PREFIX = "lang_book_";
const string DMFI_LANG_BOOK_MIN_VAR = "lang_book_min";
const string DMFI_LANG_BOOK_GAIN_VAR = "lang_book_gain";
const string DMFI_LANG_BOOK_MAX_VAR = "lang_book_max";

int LangBookIsBook(string sTag)
{
    return GetStringLeft(sTag, GetStringLength(DMFI_LANG_BOOK_PREFIX)) == DMFI_LANG_BOOK_PREFIX;
}

// Tag lang_book_<id>_<volume>: returns the language id, 0 if malformed.
int LangBookLanguage(string sTag)
{
    string sRest = GetStringRight(sTag, GetStringLength(sTag) - GetStringLength(DMFI_LANG_BOOK_PREFIX));
    int iUnderscore = FindSubString(sRest, "_");
    if (iUnderscore < 1) return 0;
    return StringToInt(GetStringLeft(sRest, iUnderscore));
}

int LangBookVolume(string sTag)
{
    string sRest = GetStringRight(sTag, GetStringLength(sTag) - GetStringLength(DMFI_LANG_BOOK_PREFIX));
    int iUnderscore = FindSubString(sRest, "_");
    if (iUnderscore < 1) return 0;
    return StringToInt(GetStringRight(sRest, GetStringLength(sRest) - iUnderscore - 1));
}

// Fluency a reader needs to follow volume iVolume of iVolumes.
int LangBookVolumeMin(int iVolume, int iVolumes)
{
    return (iVolume - 1) * DMFI_LANG_FLUENT / iVolumes;
}

// Fluency volume iVolume of iVolumes takes a reader to (fluent for the last).
int LangBookVolumeMax(int iVolume, int iVolumes)
{
    if (iVolume >= iVolumes) return DMFI_LANG_FLUENT;
    return iVolume * DMFI_LANG_FLUENT / iVolumes;
}

// Sets iMin, iGain and iMax for oBook. FALSE if the book has no valid numbers.
int LangBookNumbers(object oBook, int iVolume, int iVolumes)
{
    int iMin = GetLocalInt(oBook, DMFI_LANG_BOOK_MIN_VAR);
    int iGain = GetLocalInt(oBook, DMFI_LANG_BOOK_GAIN_VAR);
    int iMax = GetLocalInt(oBook, DMFI_LANG_BOOK_MAX_VAR);
    if (iGain > 0 || iMax > 0)
    {
        if (iMax < 1 || iMax > DMFI_LANG_FLUENT) iMax = DMFI_LANG_FLUENT;
        if (iGain < 1) iGain = iMax - iMin;
    }
    else
    {
        if (iVolume < 1 || iVolume > iVolumes) return FALSE;
        iMin = LangBookVolumeMin(iVolume, iVolumes);
        iMax = LangBookVolumeMax(iVolume, iVolumes);
        iGain = iMax - iMin;
    }
    SetLocalInt(oBook, "lang_book_calc_min", iMin);
    SetLocalInt(oBook, "lang_book_calc_gain", iGain);
    SetLocalInt(oBook, "lang_book_calc_max", iMax);
    return iGain > 0;
}

// Uses up one book (one of a stack).
void LangBookConsume(object oBook)
{
    int iStack = GetItemStackSize(oBook);
    if (iStack > 1) SetItemStackSize(oBook, iStack - 1);
    else DestroyObject(oBook);
}

// Item activation: studies the book.
void LangBookUse(object oPC, object oBook)
{
    string sTag = GetTag(oBook);
    int iLang = LangBookLanguage(sTag);
    int iVolume = LangBookVolume(sTag);
    int iVolumes = LangCfgBookVolumes();
    if (!LangIsLearnable(iLang) || !LangBookNumbers(oBook, iVolume, iVolumes))
    {
        SendMessageToPC(oPC, "The text is unreadable.");
        return;
    }
    int iMin = GetLocalInt(oBook, "lang_book_calc_min");
    int iGain = GetLocalInt(oBook, "lang_book_calc_gain");
    int iMax = GetLocalInt(oBook, "lang_book_calc_max");
    DeleteLocalInt(oBook, "lang_book_calc_min");
    DeleteLocalInt(oBook, "lang_book_calc_gain");
    DeleteLocalInt(oBook, "lang_book_calc_max");

    string sName = LangName(iLang);
    int iLevel = LangFluency(oPC, iLang);
    if (iLevel >= iMax)
    {
        SendMessageToPC(oPC, "You already know everything this book teaches of " + sName + ".");
        return;
    }
    if (iLevel < iMin)
    {
        if (iLevel == 0)
            SendMessageToPC(oPC, "You cannot follow this. Start with an earlier book of " + sName + ".");
        else
            SendMessageToPC(oPC, "You cannot follow this yet. It needs " + LangPercent(iMin) + " of " + sName + " and you have " + LangPercent(iLevel) + ".");
        return;
    }

    // Only a new language takes a slot; later books are free.
    if (iLevel == 0 && !LangTakeSlot(oPC))
    {
        SendMessageToPC(oPC, "You have no spare language slots (you know " + IntToString(LangSlotsTotal(oPC)) + " of " + IntToString(LangSlotsTotal(oPC)) + "). Only a higher Intelligence modifier makes room for another language.");
        return;
    }
    int iNew = iLevel + iGain;
    if (iNew > iMax) iNew = iMax;
    LangListSet(oPC, iLang, iNew);
    LangBookConsume(oBook);

    string sMsg = "You study the book and it is used up. ";
    if (iNew >= DMFI_LANG_FLUENT)
        sMsg += "You are now fluent in " + sName + ".";
    else
        sMsg += "Your " + sName + " is now " + LangPercent(iNew) + " of fluent.";
    if (LangCfgSlotsIgnore())
        sMsg += " You can start any number of languages.";
    else
    {
        int iFree = LangSlotsFree(oPC);
        sMsg += " You can start " + IntToString(iFree) + " more language" + (iFree == 1 ? "" : "s") + ".";
    }
    SendMessageToPC(oPC, sMsg);
}
